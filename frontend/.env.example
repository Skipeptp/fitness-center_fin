# VOLT Frontend — переменные окружения
# Скопируй в .env.local для локальной разработки без Docker

# URL бэкенда (без trailing slash)
# В Docker Vite прокисирует /api на backend через vite.config.js —
# эта переменная нужна только если запускаешь фронт отдельно от прокси.
VITE_API_URL=http://localhost:3000/api

# Для Docker-билда (передаётся через ARG в Dockerfile)
# VITE_API_URL=http://localhost:3000/api
