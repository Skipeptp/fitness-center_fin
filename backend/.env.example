# VOLT Backend — переменные окружения
# Скопируй в .env и заполни боевыми значениями

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_db
DB_USER=fitness_admin
DB_PASSWORD=fitness_pass_2026

# JWT — один секрет для MVP; в прод можно добавить JWT_REFRESH_SECRET отдельным
JWT_SECRET=change_me_in_production_please
# JWT_REFRESH_SECRET=another_secret_for_refresh_in_prod

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Bcrypt
BCRYPT_ROUNDS=12

# CORS — адрес фронтенда (без слеша на конце)
FRONTEND_ORIGIN=http://localhost:5173

# Порт сервера
PORT=3000

# Окружение
NODE_ENV=development
